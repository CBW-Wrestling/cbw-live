# Arena — credenciais de um app com grant "https://arena.uww.io/grants/api_key"
# e a API Key de um usuário com ROLE_SCOREBOARD (Settings → Apps / Settings → Users).
ARENA_URL=http://localhost:8080
ARENA_CLIENT_ID=
ARENA_CLIENT_SECRET=
ARENA_API_KEY=
# Evento a acompanhar (vazio = todos os eventos que o placar enxerga)
ARENA_EVENT_ID=

# Mercure — hub do Arena (exposto pelo nginx). Chave = MERCURE_PUBLISHER_JWT_KEY do container caddy.
MERCURE_HUB_URL=http://localhost:8080/.well-known/mercure
MERCURE_JWT_KEY=

# Serviço CBW
LISTEN_ADDR=:8095
DATA_DIR=data
# Token configurado no webhook do Arena. Enquanto não conhecemos o payload, só registramos se confere.
WEBHOOK_TOKEN=
WEBHOOK_TOKEN_ENFORCE=false
# Ressincronização de segurança com o REST (segundos, 0 = desliga)
RESYNC_SECONDS=15
